+/// The order a request puts its pseudo-header fields in.
+///
+/// RFC 9113 leaves the order open and the clients disagree, so a client that
+/// imitates one of them has to send that client's order: h2's own is
+/// `:method, :scheme, :authority, :path`, Chrome sends `:method, :authority,
+/// :scheme, :path`, Firefox `:method, :path, :authority, :scheme` and Safari
+/// `:method, :scheme, :path, :authority`. No fingerprint hash sees it — JA3 and
+/// JA4 cover the ClientHello, not the h2 preface.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum PseudoOrder {
+    /// h2's own order: `:method, :scheme, :authority, :path`.
+    #[default]
+    MethodSchemeAuthorityPath,
+    /// Chrome: `:method, :authority, :scheme, :path`.
+    MethodAuthoritySchemePath,
+    /// Firefox: `:method, :path, :authority, :scheme`.
+    MethodPathAuthorityScheme,
+    /// Safari: `:method, :scheme, :path, :authority`.
+    MethodSchemePathAuthority,
