+    #[test]
+    fn test_appended_spellings_that_differ_only_in_case_are_distinct() {
+        let mut case_map = HeaderCaseMap::default();
+
+        // A name the map does not mention has no spelling, so the encoder
+        // writes the lowercased `HeaderName`.
+        assert_eq!(
